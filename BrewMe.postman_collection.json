{
  "info": {
    "name": "BrewMe API",
    "_postman_id": "b3e0c0a1-0000-4000-8000-brewme000001",
    "description": "REST API for the BrewMe creator-support platform. Generated from API.md.\n\nSet collection variables `baseUrl`, `username`, and `token` (the latter is auto-filled by the Login/Signup requests via a test script).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "username", "value": "sarahchen", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication & Account",
      "item": [
        {
          "name": "Signup",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth", "signup"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Sarah Chen\",\n  \"email\": \"sarah@example.com\",\n  \"password\": \"min8chars\",\n  \"username\": \"sarahchen\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const t = pm.response.json().token;",
                  "  if (t) pm.collectionVariables.set('token', t);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sarah@example.com\",\n  \"password\": \"min8chars\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const t = pm.response.json().token;",
                  "  if (t) pm.collectionVariables.set('token', t);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        },
        {
          "name": "Get current user (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Check username availability",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/username-available?username=sarahchen",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "username-available"],
              "query": [{ "key": "username", "value": "sarahchen" }]
            }
          }
        }
      ]
    },
    {
      "name": "2. Public Creator Pages",
      "item": [
        {
          "name": "Get creator profile",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/creators/{{username}}", "host": ["{{baseUrl}}"], "path": ["creators", "{{username}}"] }
          }
        },
        {
          "name": "Get creator supporters feed",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/creators/{{username}}/supporters?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["creators", "{{username}}", "supporters"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "cursor", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get creator posts",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/creators/{{username}}/posts?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["creators", "{{username}}", "posts"],
              "query": [
                { "key": "limit", "value": "10" },
                { "key": "cursor", "value": "", "disabled": true }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Donations",
      "item": [
        {
          "name": "Create donation (buy coffees)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/creators/{{username}}/donations",
              "host": ["{{baseUrl}}"],
              "path": ["creators", "{{username}}", "donations"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cups\": 3,\n  \"supporter_name\": \"Emily R.\",\n  \"message\": \"Love your work! 🎨\",\n  \"is_anonymous\": false,\n  \"payment_method_id\": \"pm_xxx\"\n}"
            }
          }
        },
        {
          "name": "Stripe webhook (signed)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Stripe-Signature", "value": "t=...,v1=..." }
            ],
            "url": { "raw": "{{baseUrl}}/webhooks/stripe", "host": ["{{baseUrl}}"], "path": ["webhooks", "stripe"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"payment_intent.succeeded\",\n  \"data\": { \"object\": { \"id\": \"pi_xxx\" } }\n}"
            }
          }
        }
      ]
    },

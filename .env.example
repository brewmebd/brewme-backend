# Copy to .env for local development.
APP_ENV=development
PORT=8080
DATABASE_DSN=user:pass@tcp(127.0.0.1:3306)/brewme?parseTime=true&charset=utf8mb4
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
JWT_SECRET=change-me
CORS_ALLOW_ORIGIN=http://localhost:5173
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=
STRIPE_CONNECT_RETURN_URL=http://localhost:5173/dashboard/settings
STRIPE_CONNECT_REFRESH_URL=http://localhost:5173/dashboard/settings
FRONTEND_BASE_URL=http://localhost:5173
RESEND_API_KEY=re_your_resend_api_key_here
